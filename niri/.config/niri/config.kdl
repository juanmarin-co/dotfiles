spawn-at-startup "qs" "--no-duplicate"
spawn-at-startup "swayidle" "-w"
spawn-sh-at-startup "swaybg -i ~/Pictures/wallpaper.png -m fill"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

environment {
    GTK_IM_MODULE "simple"
    MOZ_DRM_DEVICE "/dev/dri/renderD128"
    VK_DRIVER_FILES "/usr/share/vulkan/icd.d/intel_icd.json"
    __EGL_VENDOR_LIBRARY_FILENAMES "/usr/share/glvnd/egl_vendor.d/50_mesa.json"
}

input {
    keyboard {
        xkb {
            options "compose:ralt"
        }
    }

    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 4
    default-column-width { proportion 1.0; }

    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }

    focus-ring {
        width 1
        active-color "#565b66"
        inactive-color "#273344"
    }

    border { off; }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match app-id="com.gabm.satty"
    open-floating true
}

window-rule {
    match app-id="com.ghostty.nmtui"
    open-floating true
}

window-rule {
    match app-id="polkit-gnome-authentication-agent-1"
    open-floating true
}

window-rule {
    match app-id=r#"^steam_app_\d+$"#
    open-fullscreen true
}

debug {
    honor-xdg-activation-with-invalid-serial
    render-drm-device "/dev/dri/renderD128"
    ignore-drm-device "/dev/dri/by-path/pci-0000:01:00.0-card"
}

// Keep overview keyboard-driven.
gestures {
    hot-corners { off; }
}

binds {
    // Applications.
    Mod+1 { spawn-sh "~/.config/niri/scripts/focus-or-launch firefox"; }
    Mod+2 { spawn-sh "~/.config/niri/scripts/focus-or-launch com.mitchellh.ghostty ghostty"; }
    Mod+Space { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Super+Alt+L { spawn "swaylock" "-f" "-c" "000000"; }

    // H/L navigates columns. J/K traverses a stack, then the adjacent workspace.
    Mod+H { focus-column-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-right; }

    // Ctrl moves windows; J/K crosses into a workspace at the stack edge.
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+L { move-column-right; }

    // Shift+J/K reorders whole workspaces.
    Mod+Shift+J { move-workspace-down; }
    Mod+Shift+K { move-workspace-up; }

    // Common layout actions.
    Mod+O { toggle-overview; }
    Mod+Q { close-window; }
    Mod+F { switch-preset-column-width; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Audio and media controls.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }

    // Screenshots and session controls.
    Print { spawn-sh "grim -g \"$(slurp)\" - | satty --filename -"; }
    Ctrl+Print { spawn-sh "grim - | satty --filename -"; }
    Alt+Print { screenshot-window; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+E { quit; }
}
