// Allow wheel to switch the NVIDIA dGPU power mode without a password prompt.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "gpu-mode-integrated.service" ||
         action.lookup("unit") == "gpu-mode-hybrid.service") &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
