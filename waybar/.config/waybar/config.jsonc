{
    "layer": "top",
    "position": "top",
    "margin-left": 4,
    "margin-right": 4,
    "spacing": 2,
    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/thermals",
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "backlight",
        "power-profiles-daemon",
        "battery",
        "custom/dnd",
        "tray"
    ],
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "●",
            "active": "●",
            "default": "○"
        },
        "on-scroll-up": "niri msg action focus-column-left",
        "on-scroll-down": "niri msg action focus-column-right",
        "on-scroll-left": "niri msg action focus-column-left",
        "on-scroll-right": "niri msg action focus-column-right"
    },
    "clock": {
        "interval": 1,
        "format": "{:%a %b %d  %H:%M:%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#59c2ff'><b>{}</b></span>",
                "days": "<span color='#bfbdb6'><b>{}</b></span>",
                "weeks": "<span color='#5a6378'><b>W{}</b></span>",
                "weekdays": "<span color='#ffb454'><b>{}</b></span>",
                "today": "<span color='#e6b450'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "default": ["", "", ""]
        }
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [""],
        "scroll-step": 5
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " wired",
        "format-disconnected": "⚠ disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "ghostty --class=com.ghostty.nmtui --window-width=70 --window-height=24 -e nmtui connect"
    },
    "cpu": {
        "format": " {usage}%"
    },
    "custom/thermals": {
        "format": "{}",
        "align": 1,
        "return-type": "json",
        "restart-interval": 2,
        "exec": "/usr/local/bin/rz09-control waybar"
    },
    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "custom/dnd": {
        "interval": "once",
        "return-type": "json",
        "format": "{text}",
        "exec": "if makoctl mode | grep -q 'dnd'; then echo '{\"text\": \"\", \"tooltip\": \"Do Not Disturb: Active\", \"class\": \"dnd\"}'; else echo '{\"text\": \"\", \"tooltip\": \"Do Not Disturb: Inactive\", \"class\": \"none\"}'; fi",
        "on-click": "makoctl mode -t dnd; pkill -RTMIN+8 waybar",
        "signal": 8
    }
}
