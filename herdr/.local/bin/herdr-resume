#!/usr/bin/env node
// herdr-resume: persist and restore pi, codex, and agy sessions across reboots
// using herdr-core terminal labels (`hc label`).

import { execFileSync } from "node:child_process";
import { existsSync, readFileSync, statSync } from "node:fs";

const SUPPORTED_AGENTS = new Set(["pi", "codex", "agy"]);
const DELIBERATE_EXIT_REASONS = new Set([
  "prompt_input_exit",
  "logout",
  "clear",
  "quit",
  "exit",
]);

// Per-agent runtime flag whitelist. Anything outside this list is ignored.
const FLAG_WHITELIST = {
  pi: {
    value: new Set(["--session-dir", "--tui-mode"]),
    bool: new Set(["--no-context-files", "-nc", "--no-approve", "-na", "--offline"]),
  },
  codex: {
    value: new Set([
      "-c",
      "--config",
      "--enable",
      "--disable",
      "-p",
      "--profile",
      "-s",
      "--sandbox",
      "--add-dir",
      "--remote",
      "--remote-auth-token-env",
    ]),
    bool: new Set(["--search", "--no-alt-screen", "--no-daemon"]),
  },
  agy: {
    value: new Set(["--mode", "--effort", "--agent", "--add-dir", "--project", "--settings"]),
    bool: new Set(["--sandbox", "--remote-agent", "--remote-control"]),
  },
};

function readStdin() {
  try {
    return readFileSync(0, "utf8");
  } catch {
    return "";
  }
}

function parseJson(raw) {
  if (!raw || !raw.trim()) {
    return null;
  }
  try {
    return JSON.parse(raw);
  } catch {
    return null;
  }
}

function runHc(args) {
  try {
    return execFileSync("hc", args, {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
      timeout: 3000,
    });
  } catch {
    return null;
  }
}

function getTerminal(id) {
  const out = runHc(["get", id, "--json"]);
  return parseJson(out);
}

function setLabel(id, value) {
  runHc(["label", id, `resume=${value}`]);
}

function shellQuote(str) {
  return `'${String(str).replace(/'/g, "'\\''")}'`;
}

function isOwnedByTarget(startPid, targetPid) {
  if (!startPid || !targetPid) {
    return false;
  }
  let current = Number(startPid);
  const goal = Number(targetPid);
  const seen = new Set();
  while (current > 1 && !seen.has(current)) {
    if (current === goal) {
      return true;
    }
    seen.add(current);
    try {
      const stat = readFileSync(`/proc/${current}/stat`, "utf8");
      const closeParen = stat.lastIndexOf(")");
      if (closeParen === -1) {
        return false;
      }
      const rest = stat.slice(closeParen + 2).split(" ");
      current = Number(rest[1]);
    } catch {
      return false;
    }
  }
  return false;
}

function readProcArgv(pid) {
  try {
    const raw = readFileSync(`/proc/${pid}/cmdline`);
    return raw
      .toString("utf8")
      .split("\0")
      .filter((part) => {
        return part.length > 0;
      });
  } catch {
    return [];
  }
}

function isOneShot(agent, argv) {
  for (const arg of argv.slice(1)) {
    if (agent === "codex" && arg === "exec") {
      return true;
    }
    if ((agent === "pi" || agent === "agy") && (arg === "-p" || arg === "--print")) {
      return true;
    }
  }
  return false;
}

function filterFlags(agent, argv) {
  const kept = [];
  const whitelist = FLAG_WHITELIST[agent];
  if (!whitelist) {
    return kept;
  }

  const args = argv.slice(1);
  let i = 0;

  while (i < args.length) {
    const arg = args[i];
    if (arg === "--") {
      break;
    }

    const eqIdx = arg.indexOf("=");
    let flagName = arg;
    let hasInlineVal = false;
    if (eqIdx !== -1) {
      flagName = arg.slice(0, eqIdx);
      hasInlineVal = true;
    }

    if (whitelist.value.has(flagName)) {
      if (hasInlineVal) {
        kept.push(arg);
        i += 1;
      } else if (i + 1 < args.length) {
        kept.push(flagName, args[i + 1]);
        i += 2;
      } else {
        i += 1;
      }
      continue;
    }

    if (!hasInlineVal && whitelist.bool.has(flagName)) {
      kept.push(flagName);
    }

    i += 1;
  }

  return kept;
}

function parseCliArgs(argv) {
  const cmd = argv[2] || "";
  let agentHint = "";
  for (let i = 3; i < argv.length; i += 1) {
    if (argv[i] === "--agent" && i + 1 < argv.length) {
      agentHint = argv[i + 1];
      i += 1;
    }
  }
  return { cmd, agentHint };
}

function handleHook(agentHint) {
  const terminalId = process.env.HC_TERMINAL_ID || "";
  if (!terminalId) {
    return;
  }

  const payload = parseJson(readStdin()) || {};
  const terminal = getTerminal(terminalId);
  if (!terminal) {
    return;
  }

  const event = String(payload.hook_event_name || payload.hookEventName || "");
  const session = String(payload.session_id || payload.conversationId || "");
  const targetPid = terminal.foreground?.pid || terminal.pid;

  if (!isOwnedByTarget(process.ppid, targetPid)) {
    return;
  }

  if (event === "SessionEnd") {
    const reason = String(payload.reason || "");
    if (reason && DELIBERATE_EXIT_REASONS.has(reason)) {
      setLabel(terminalId, "");
    }
    return;
  }

  const isRecordEvent =
    event === "SessionStart" || event === "PreInvocation" || event === "UserPromptSubmit";
  if (!isRecordEvent || !session) {
    return;
  }

  const agent = agentHint || String(terminal.status?.app || "");
  if (!SUPPORTED_AGENTS.has(agent)) {
    return;
  }

  let argv = [];
  if (Array.isArray(payload.argv) && payload.argv.length > 0) {
    argv = payload.argv.map(String);
  } else if (Array.isArray(terminal.foreground?.argv) && terminal.foreground.argv.length > 0) {
    argv = terminal.foreground.argv.map(String);
  } else if (targetPid) {
    argv = readProcArgv(targetPid);
  }

  if (isOneShot(agent, argv)) {
    return;
  }

  const cwd = String(payload.cwd || terminal.foreground?.cwd || terminal.cwd || "");
  if (!cwd) {
    return;
  }

  const record = {
    agent,
    session,
    cwd,
    flags: filterFlags(agent, argv),
  };
  setLabel(terminalId, JSON.stringify(record));
}

function handleClear() {
  const terminalId = process.env.HC_TERMINAL_ID || "";
  if (!terminalId) {
    return;
  }
  setLabel(terminalId, "");
}

function handleCheck() {
  const terminalId = process.env.HC_TERMINAL_ID || "";
  if (!terminalId) {
    return;
  }

  const terminal = getTerminal(terminalId);
  if (!terminal || !terminal.labels || !terminal.labels.resume) {
    return;
  }

  const rec = parseJson(terminal.labels.resume);
  if (!rec || !SUPPORTED_AGENTS.has(rec.agent) || !rec.session || !rec.cwd) {
    return;
  }

  try {
    if (!existsSync(rec.cwd) || !statSync(rec.cwd).isDirectory()) {
      return;
    }
  } catch {
    return;
  }

  // Consume the label before launching so a startup failure never loops.
  setLabel(terminalId, "");

  let cmdParts = [];
  if (rec.agent === "pi") {
    cmdParts = ["pi", "--session", rec.session];
  } else if (rec.agent === "codex") {
    cmdParts = ["codex", "resume", rec.session];
  } else if (rec.agent === "agy") {
    cmdParts = ["agy", "--conversation", rec.session];
  }

  if (Array.isArray(rec.flags)) {
    for (const flag of rec.flags) {
      cmdParts.push(String(flag));
    }
  }

  const cmdLine = cmdParts.map(shellQuote).join(" ");
  const notice = `↻ herdr-resume: resuming ${rec.agent} (${rec.session.slice(0, 8)})`;

  const lines = [
    `cd ${shellQuote(rec.cwd)} || return`,
    `print -P "%F{244}${notice.replace(/"/g, '\\"')}%f"`,
    cmdLine,
  ];
  process.stdout.write(`${lines.join("\n")}\n`);
}

function handlePrecmd() {
  const terminalId = process.env.HC_TERMINAL_ID || "";
  if (!terminalId) {
    return;
  }
  const terminal = getTerminal(terminalId);
  if (!terminal || !terminal.labels || !terminal.labels.resume) {
    return;
  }
  const rec = parseJson(terminal.labels.resume);
  // agy has no SessionEnd hook; if the shell returned to prompt cleanly, clear the label.
  if (rec && rec.agent === "agy") {
    setLabel(terminalId, "");
  }
}

function main() {
  const { cmd, agentHint } = parseCliArgs(process.argv);
  try {
    if (cmd === "hook") {
      handleHook(agentHint);
    } else if (cmd === "clear") {
      handleClear();
    } else if (cmd === "check") {
      handleCheck();
    } else if (cmd === "precmd") {
      handlePrecmd();
    }
  } finally {
    if (cmd === "hook" && agentHint === "agy") {
      process.stdout.write("{}\n");
    }
  }
}

main();
